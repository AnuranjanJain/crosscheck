{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crosscheck.local/evaluation-labels.v1.schema.json",
  "title": "Crosscheck reviewed evaluation labels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "split",
    "dataset",
    "created_on",
    "notes",
    "facts",
    "relationships"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "split": {
      "type": "string",
      "enum": [
        "development",
        "held_out"
      ]
    },
    "dataset": {
      "type": "string",
      "enum": [
        "delhivery",
        "india-macroeconomy"
      ]
    },
    "created_on": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "document_filename",
          "pdf_page_index",
          "evidence_quote",
          "subject",
          "predicate",
          "value_text",
          "value_number",
          "unit",
          "period",
          "scope",
          "estimate_status",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "document_filename": {
            "type": "string"
          },
          "pdf_page_index": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_quote": {
            "type": "string",
            "minLength": 8
          },
          "subject": {
            "type": "string"
          },
          "predicate": {
            "type": "string"
          },
          "value_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "value_number": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "period": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimate_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "left_fact_id",
          "right_fact_id",
          "expected_label",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "left_fact_id": {
            "type": "string"
          },
          "right_fact_id": {
            "type": "string"
          },
          "expected_label": {
            "type": "string",
            "enum": [
              "corroboration",
              "likely_contradiction",
              "contextual_reconciliation",
              "insufficient_evidence"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
